{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InitializeParams",
  "description": "Parameters sent by the client in the `initialize` request.",
  "type": "object",
  "properties": {
    "protocol_version": {
      "type": "string"
    },
    "client_info": {
      "$ref": "#/$defs/ClientInfo"
    },
    "capabilities": {
      "$ref": "#/$defs/ClientCapabilities",
      "default": {
        "streaming": false,
        "experimental_methods": false
      }
    }
  },
  "required": [
    "protocol_version",
    "client_info"
  ],
  "$defs": {
    "ClientInfo": {
      "description": "Identifies the connecting client.",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version"
      ]
    },
    "ClientCapabilities": {
      "description": "Capabilities declared by the client during the handshake.",
      "type": "object",
      "properties": {
        "streaming": {
          "type": "boolean",
          "default": false
        },
        "experimental_methods": {
          "type": "boolean",
          "default": false
        },
        "interactive_questions": {
          "description": "Interactive question behaviors this connection can complete. Missing\nmeans the capability is off.",
          "anyOf": [
            {
              "$ref": "#/$defs/InteractiveQuestionsCapability"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "InteractiveQuestionsCapability": {
      "type": "object",
      "properties": {
        "single_select": {
          "type": "boolean",
          "default": false
        },
        "multi_select": {
          "type": "boolean",
          "default": false
        },
        "free_text": {
          "type": "boolean",
          "default": false
        },
        "previews": {
          "type": "boolean",
          "default": false
        },
        "annotations": {
          "type": "boolean",
          "default": false
        },
        "special_outcomes": {
          "type": "boolean",
          "default": false
        }
      }
    }
  }
}
