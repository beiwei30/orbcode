{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ClientCapabilities",
  "description": "Capabilities declared by the client during the handshake.",
  "type": "object",
  "properties": {
    "streaming": {
      "type": "boolean",
      "default": false
    },
    "experimental_methods": {
      "type": "boolean",
      "default": false
    },
    "persistent_goals": {
      "description": "Opts this connection into the experimental persistent-goal method\nfamily. `experimental_methods` must also be enabled.",
      "type": "boolean",
      "default": false
    },
    "interactive_questions": {
      "description": "Interactive question behaviors this connection can complete. Missing\nmeans the capability is off.",
      "anyOf": [
        {
          "$ref": "#/$defs/InteractiveQuestionsCapability"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "$defs": {
    "InteractiveQuestionsCapability": {
      "type": "object",
      "properties": {
        "single_select": {
          "type": "boolean",
          "default": false
        },
        "multi_select": {
          "type": "boolean",
          "default": false
        },
        "free_text": {
          "type": "boolean",
          "default": false
        },
        "previews": {
          "type": "boolean",
          "default": false
        },
        "annotations": {
          "type": "boolean",
          "default": false
        },
        "special_outcomes": {
          "type": "boolean",
          "default": false
        }
      }
    }
  }
}
