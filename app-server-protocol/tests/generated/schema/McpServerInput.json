{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "McpServerInput",
  "description": "Secret-bearing input accepted by MCP upsert and session bootstrap methods.",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "transport": {
      "$ref": "#/$defs/McpTransport"
    },
    "endpoint": {
      "type": "string"
    },
    "args": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    },
    "env": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "default": {}
    },
    "cwd": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "headers": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "default": {}
    },
    "enabled": {
      "type": "boolean"
    },
    "status": {
      "$ref": "#/$defs/McpServerStatus",
      "default": "ready"
    },
    "error": {
      "type": [
        "string",
        "null"
      ],
      "default": null
    },
    "summary": {
      "type": "string"
    },
    "auth": {
      "$ref": "#/$defs/McpAuth"
    },
    "trust": {
      "$ref": "#/$defs/McpServerTrust",
      "default": "unknown"
    },
    "transport_type_hint": {
      "type": [
        "string",
        "null"
      ]
    },
    "source": {
      "anyOf": [
        {
          "$ref": "#/$defs/McpServerSource"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "id",
    "transport",
    "endpoint",
    "enabled",
    "summary",
    "auth"
  ],
  "$defs": {
    "McpTransport": {
      "description": "Transport selected for an MCP server.\n\nThis is a wire DTO. Runtime transport behavior remains owned by\n`orbcode-mcp` and is converted at the app-server boundary.",
      "type": "string",
      "enum": [
        "stdio",
        "http",
        "https",
        "streamable_http",
        "web_socket"
      ]
    },
    "McpServerStatus": {
      "type": "string",
      "enum": [
        "disabled",
        "starting",
        "ready",
        "failed",
        "unauthorized",
        "restarting",
        "stopped"
      ]
    },
    "McpAuth": {
      "description": "Authentication input accepted by MCP mutation methods.\n\nHeader values are intentionally possible here because this is a write\ncontract. Read methods use [`McpAuthOverview`] instead.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "none"
            }
          },
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "env_var": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "bearer_env"
            }
          },
          "required": [
            "kind",
            "env_var"
          ]
        },
        {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "value": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "header"
            }
          },
          "required": [
            "kind",
            "name",
            "value"
          ]
        }
      ]
    },
    "McpServerTrust": {
      "type": "string",
      "enum": [
        "unknown",
        "trusted",
        "denied"
      ]
    },
    "McpServerSource": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "plugin"
            }
          },
          "$ref": "#/$defs/McpPluginSource",
          "required": [
            "kind"
          ]
        }
      ]
    },
    "McpPluginSource": {
      "type": "object",
      "properties": {
        "plugin_id": {
          "type": "string"
        },
        "plugin_name": {
          "type": "string"
        },
        "server_name": {
          "type": "string"
        },
        "source": {
          "type": "string"
        }
      },
      "required": [
        "plugin_id",
        "plugin_name",
        "server_name",
        "source"
      ]
    }
  }
}
