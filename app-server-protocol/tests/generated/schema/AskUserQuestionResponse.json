{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AskUserQuestionResponse",
  "description": "Client's response to an [`AskUserQuestionRequest`].",
  "type": "object",
  "properties": {
    "request_id": {
      "description": "The `request_id` from the original [`AskUserQuestionRequest`].",
      "type": "string"
    },
    "outcome": {
      "description": "Canonical typed response. New clients should always populate this.",
      "anyOf": [
        {
          "$ref": "#/$defs/AskUserResponseOutcome"
        },
        {
          "type": "null"
        }
      ]
    },
    "answer": {
      "description": "Legacy protocol-1.0 answer. A missing or null value normalizes to a\nclient-closed cancellation.",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "request_id"
  ],
  "$defs": {
    "AskUserResponseOutcome": {
      "description": "Canonical response lifecycle for an interactive question request.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "answers": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/AskUserAnswerValue"
              }
            },
            "annotations": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "outcome": {
              "type": "string",
              "const": "answered"
            }
          },
          "required": [
            "outcome",
            "answers"
          ]
        },
        {
          "type": "object",
          "properties": {
            "outcome": {
              "type": "string",
              "const": "rejected"
            }
          },
          "required": [
            "outcome"
          ]
        },
        {
          "type": "object",
          "properties": {
            "outcome": {
              "type": "string",
              "const": "clarify"
            }
          },
          "required": [
            "outcome"
          ]
        },
        {
          "type": "object",
          "properties": {
            "outcome": {
              "type": "string",
              "const": "finish_plan_interview"
            }
          },
          "required": [
            "outcome"
          ]
        },
        {
          "type": "object",
          "properties": {
            "reason": {
              "$ref": "#/$defs/AskUserCancellationReason"
            },
            "outcome": {
              "type": "string",
              "const": "cancelled"
            }
          },
          "required": [
            "outcome",
            "reason"
          ]
        }
      ]
    },
    "AskUserAnswerValue": {
      "description": "A typed answer to one canonical question.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "text"
            }
          },
          "required": [
            "kind",
            "text"
          ]
        },
        {
          "type": "object",
          "properties": {
            "option_id": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "selected"
            }
          },
          "required": [
            "kind",
            "option_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "option_ids": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "kind": {
              "type": "string",
              "const": "selected_many"
            }
          },
          "required": [
            "kind",
            "option_ids"
          ]
        }
      ]
    },
    "AskUserCancellationReason": {
      "description": "Why a pending interactive question was cancelled.",
      "type": "string",
      "enum": [
        "interrupt",
        "disconnect",
        "timeout",
        "client_closed",
        "delivery_failed",
        "session_closed",
        "shutdown"
      ]
    }
  }
}
