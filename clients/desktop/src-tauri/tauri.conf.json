{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orbcode Desktop",
  "version": "0.0.1",
  "identifier": "com.orbcode.desktop",
  "build": {
    "beforeBuildCommand": "npm run build:web",
    "beforeDevCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Orbcode Desktop",
        "width": 860,
        "height": 720,
        "minWidth": 520,
        "minHeight": 520,
        "resizable": true,
        "devtools": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self'; style-src 'self'; script-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'",
      "dangerousDisableAssetCspModification": false,
      "freezePrototype": true,
      "capabilities": ["desktop-host"]
    }
  },
  "bundle": {
    "active": false,
    "icon": ["../../desktop-spike/src-tauri/icons/32x32.png"]
  }
}
